{
  "name": "smarterp",
  "version": "1.0.0",
  "description": "SmartERP - Full ERP System for SME (Similar to Kingdee JDY)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "postinstall": "prisma generate --schema=packages/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "@vercel/node": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "concurrently": "^8.2.2",
    "prisma": "^5.9.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
