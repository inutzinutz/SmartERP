generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// CORE: Organization & Users
// ============================================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  logo        String?
  address     String?
  phone       String?
  email       String?
  website     String?
  taxId       String?
  currency    String   @default("THB")
  timezone    String   @default("Asia/Bangkok")
  locale      String   @default("th")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  warehouses  Warehouse[]
  customers   Customer[]
  suppliers   Supplier[]
  products    Product[]
  categories  Category[]
  accounts    Account[]
  stores      Store[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  expenseClaims     ExpenseClaim[]
  approvals         Approval[]
  auditLogs         AuditLog[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  SALES
  WAREHOUSE
  STORE_MANAGER
  STAFF
}

// ============================================================
// INVENTORY MODULE
// ============================================================

model Category {
  id             String   @id @default(uuid())
  name           String
  code           String
  description    String?
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  products       Product[]

  @@unique([organizationId, code])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  code           String
  barcode        String?
  description    String?
  unit           String   @default("piece")
  costPrice      Decimal  @default(0) @db.Decimal(15, 4)
  sellingPrice   Decimal  @default(0) @db.Decimal(15, 4)
  minStock       Int      @default(0)
  maxStock       Int?
  weight         Decimal? @db.Decimal(10, 3)
  imageUrl       String?
  isActive       Boolean  @default(true)
  trackInventory Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  stockItems         StockItem[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@unique([organizationId, code])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(uuid())
  name           String
  code           String
  address        String?
  contactPerson  String?
  phone          String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@map("warehouses")
}

model StockItem {
  id            String   @id @default(uuid())
  quantity      Decimal  @default(0) @db.Decimal(15, 4)
  reservedQty   Decimal  @default(0) @db.Decimal(15, 4)
  updatedAt     DateTime @updatedAt

  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("stock_items")
}

model StockMovement {
  id            String        @id @default(uuid())
  type          MovementType
  quantity      Decimal       @db.Decimal(15, 4)
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())

  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

// ============================================================
// SALES MODULE
// ============================================================

model Customer {
  id             String   @id @default(uuid())
  name           String
  code           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  creditLimit    Decimal  @default(0) @db.Decimal(15, 2)
  creditDays     Int      @default(30)
  tier           CustomerTier @default(STANDARD)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  salesOrders    SalesOrder[]
  receivables    Receivable[]

  @@unique([organizationId, code])
  @@map("customers")
}

enum CustomerTier {
  VIP
  PREMIUM
  STANDARD
  NEW
}

model SalesOrder {
  id             String      @id @default(uuid())
  orderNumber    String
  status         OrderStatus @default(DRAFT)
  orderDate      DateTime    @default(now())
  deliveryDate   DateTime?
  subtotal       Decimal     @db.Decimal(15, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(15, 2)
  discountAmount Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal     @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])

  items          SalesOrderItem[]
  receivables    Receivable[]

  @@unique([orderNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(uuid())
  quantity     Decimal @db.Decimal(15, 4)
  unitPrice    Decimal @db.Decimal(15, 4)
  discount     Decimal @default(0) @db.Decimal(15, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  totalAmount  Decimal @db.Decimal(15, 2)
  notes        String?

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

// ============================================================
// PURCHASE MODULE
// ============================================================

model Supplier {
  id             String   @id @default(uuid())
  name           String
  code           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  purchaseOrders PurchaseOrder[]
  payables       Payable[]

  @@unique([organizationId, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String      @id @default(uuid())
  orderNumber    String
  status         OrderStatus @default(DRAFT)
  orderDate      DateTime    @default(now())
  expectedDate   DateTime?
  subtotal       Decimal     @db.Decimal(15, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(15, 2)
  discountAmount Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal     @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  supplierId     String
  supplier       Supplier    @relation(fields: [supplierId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])

  items          PurchaseOrderItem[]
  payables       Payable[]

  @@unique([orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  quantity        Decimal @db.Decimal(15, 4)
  unitPrice       Decimal @db.Decimal(15, 4)
  discount        Decimal @default(0) @db.Decimal(15, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  totalAmount     Decimal @db.Decimal(15, 2)
  receivedQty     Decimal @default(0) @db.Decimal(15, 4)
  notes           String?

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ============================================================
// FINANCE MODULE
// ============================================================

model Account {
  id             String      @id @default(uuid())
  code           String
  name           String
  type           AccountType
  parentId       String?
  parent         Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children       Account[]   @relation("AccountTree")
  balance        Decimal     @default(0) @db.Decimal(15, 2)
  currency       String      @default("THB")
  isActive       Boolean     @default(true)
  isSystem       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  journalEntryLines JournalEntryLine[]

  @@unique([organizationId, code])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id           String   @id @default(uuid())
  entryNumber  String
  date         DateTime
  description  String?
  reference    String?
  isPosted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines        JournalEntryLine[]

  @@unique([entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)
  description    String?

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  @@map("journal_entry_lines")
}

model Receivable {
  id           String          @id @default(uuid())
  amount       Decimal         @db.Decimal(15, 2)
  paidAmount   Decimal         @default(0) @db.Decimal(15, 2)
  dueDate      DateTime
  status       PaymentStatus   @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?     @relation(fields: [salesOrderId], references: [id])

  payments     Payment[]

  @@map("receivables")
}

model Payable {
  id              String          @id @default(uuid())
  amount          Decimal         @db.Decimal(15, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(15, 2)
  dueDate         DateTime
  status          PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  supplierId      String
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])

  payments        Payment[]

  @@map("payables")
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())

  receivableId  String?
  receivable    Receivable?   @relation(fields: [receivableId], references: [id])
  payableId     String?
  payable       Payable?      @relation(fields: [payableId], references: [id])

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  DIGITAL_WALLET
  OTHER
}

// ============================================================
// EXPENSE MODULE
// ============================================================

model ExpenseClaim {
  id            String         @id @default(uuid())
  claimNumber   String
  title         String
  description   String?
  totalAmount   Decimal        @db.Decimal(15, 2)
  status        ApprovalStatus @default(PENDING)
  submittedAt   DateTime       @default(now())
  approvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userId        String
  user          User           @relation(fields: [userId], references: [id])

  items         ExpenseItem[]

  @@unique([claimNumber])
  @@map("expense_claims")
}

model ExpenseItem {
  id             String   @id @default(uuid())
  description    String
  amount         Decimal  @db.Decimal(15, 2)
  category       String
  receiptUrl     String?
  expenseDate    DateTime

  expenseClaimId String
  expenseClaim   ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)

  @@map("expense_items")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================
// RETAIL MODULE
// ============================================================

model Store {
  id             String   @id @default(uuid())
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  posTransactions PosTransaction[]

  @@unique([organizationId, code])
  @@map("stores")
}

model PosTransaction {
  id             String        @id @default(uuid())
  transNumber    String
  totalAmount    Decimal       @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal       @db.Decimal(15, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(15, 2)
  paymentMethod  PaymentMethod
  createdAt      DateTime      @default(now())

  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])

  items          PosTransactionItem[]

  @@unique([transNumber])
  @@map("pos_transactions")
}

model PosTransactionItem {
  id               String  @id @default(uuid())
  productName      String
  productCode      String
  quantity         Decimal @db.Decimal(15, 4)
  unitPrice        Decimal @db.Decimal(15, 4)
  discount         Decimal @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal @db.Decimal(15, 2)

  posTransactionId String
  posTransaction   PosTransaction @relation(fields: [posTransactionId], references: [id], onDelete: Cascade)

  @@map("pos_transaction_items")
}

// ============================================================
// APPROVAL WORKFLOW
// ============================================================

model Approval {
  id           String         @id @default(uuid())
  entityType   String
  entityId     String
  status       ApprovalStatus @default(PENDING)
  comments     String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())

  approverId   String
  approver     User           @relation(fields: [approverId], references: [id])

  @@map("approvals")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
